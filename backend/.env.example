# ============================================================
# 配置模板 —— 复制一份改名为 .env 使用(不要直接改这个文件)
# 说明:这里是"空白模板",真实的密钥只写在 .env 里,.env 不会上传到 GitHub
# ============================================================

# ---------- 阿里云百炼 API 密钥(必填)----------
# 获取步骤:登录阿里云百炼控制台 → API-KEY 管理 → 创建新的 API-KEY
DASHSCOPE_API_KEY=sk-在这里粘贴你的密钥

# ---------- 大模型选择(可选,一般不用改)----------
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
RERANK_MODEL=qwen3-rerank

# ---------- 安全(部署时必须换成随机值)----------
# 生成方法:python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=换成随机密钥

# ---------- 管理员初始账号(首次启动自动创建)----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
